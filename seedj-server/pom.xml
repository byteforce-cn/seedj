<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.byteforce.seedj</groupId>
        <artifactId>root</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>seedj-server</artifactId>
    <packaging>pom</packaging>

    <name>Byteforce Seedj :: Servers</name>
    <description>可运行的参考/验证服务：IAM、HR、IM</description>

    <modules>
        <module>iam</module>
        <module>hr</module>
        <module>im</module>
    </modules>

    <properties>
        <!-- 应用模块不参与 API 兼容性门禁 -->
        <seedj.compat.skip>true</seedj.compat.skip>
        <!-- 参考服务的入口类没有独立单测，覆盖率门禁由 seedj-it 承担 -->
        <seedj.jacoco.guard.skip>true</seedj.jacoco.guard.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- 保留 thin jar 作为主制品，供 seedj-it 以普通依赖方式启动 -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
