<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.byteforce.seedj</groupId>
        <artifactId>seedj-server</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>seedj-server-hr</artifactId>
    <packaging>jar</packaging>

    <name>Byteforce Seedj :: Server :: HR</name>
    <description>HR 参考服务：验证 biz-starter 与 core/infra 在分布式场景下的能力</description>

    <properties>
        <!-- T1.5 起 HR 有 HTTP 集成测试，覆盖率门禁不再跳过 -->
        <seedj.jacoco.guard.skip>false</seedj.jacoco.guard.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-biz-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-infra-local</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-infra-local</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-jdbc-postgresql</artifactId>
        </dependency>

        <!--
            构建期处理器：provided 只为让 Maven reactor 把 seedj-codegen 纳入 -am 构建图，
            保证 annotationProcessorPaths 可解析；运行时 classpath 与打包产物都不包含它。
        -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-codegen</artifactId>
            <version>${revision}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <!-- 生成代码不计覆盖率：审查看生成器与 record，不看生成结果 -->
                    <excludes>
                        <exclude>**/*Schema</exclude>
                        <exclude>**/*View</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- JDK 23+ 默认关闭隐式注解处理；显式声明生成器与处理轮次 -->
                    <proc>full</proc>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>cn.byteforce.seedj</groupId>
                            <artifactId>seedj-codegen</artifactId>
                            <version>${revision}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
