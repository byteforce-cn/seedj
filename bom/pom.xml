<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.byteforce.seedj</groupId>
        <artifactId>root</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>bom</artifactId>
    <packaging>pom</packaging>

    <name>Byteforce :: Dependencies (BOM)</name>
    <description>Byteforce BOM：统一管理 seedj 各模块、Spring Boot 平台与第三方构件的版本（只管版本，不引包）</description>

    <properties>
        <!-- spring-boot.version 由根 POM 统一定义（随父链继承解析，单一维护点） -->
        <coord-java-sdk.version>0.3.1</coord-java-sdk.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <compile-testing.version>0.23.0</compile-testing.version>
        <!-- 收敛锚点版本（见下方 dependencyManagement 中的 error_prone_annotations 注释） -->
        <error-prone.version>2.50.0</error-prone.version>

    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 4 平台 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>


            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>codegen</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>core</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>web-core</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>security-core</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>data-core</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-json</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-web</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-resource</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-authorization</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-data-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-coord</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-coord-registry</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-coord-config</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-coord-client</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-coord-observability</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-eis-core</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-eis-audit</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-eis-temporal</artifactId>
                <version>${revision}</version>
            </dependency>

            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>starter-eis-authz</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- starter-eis-it / starter-coord-it 为测试套件模块（不产出可消费构件），不进入 BOM -->

            <!-- 第三方构件 -->

            <dependency>
                <groupId>cn.byteforce</groupId>
                <artifactId>coord-java-sdk</artifactId>
                <version>${coord-java-sdk.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!--
                收敛锚点（非直接依赖；零源码引用不等于可删）：coord-java-sdk 的 gRPC 传递链
                （grpc-netty-shaded / grpc-stub）以 compile / runtime 两种 scope 引入本坐标，
                dependencyConvergence 会判失败。此处统一版本与 scope，保证 starter-coord 门禁通过。
                实测：2026-10-07 移除即 `starter-coord` enforcer 失败。
            -->
            <dependency>
                <groupId>com.google.errorprone</groupId>
                <artifactId>error_prone_annotations</artifactId>
                <version>${error-prone.version}</version>
            </dependency>

            <dependency>
                <groupId>com.google.testing.compile</groupId>
                <artifactId>compile-testing</artifactId>
                <version>${compile-testing.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
