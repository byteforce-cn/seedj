# seedj 编辑器约定 —— 与 Spotless（google-java-format AOSP）保持一致。
# 本文件是编辑器层面的提前对齐；格式的最终判定权仍在 `mvn spotless:check`。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# Markdown 的两个行尾空格是硬换行，不能裁掉
[*.md]
trim_trailing_whitespace = false

# XML / YAML 保持仓库既有缩进宽度（避免整文件重排噪声）
[*.{xml,yml,yaml}]
indent_size = 4

[*.{sh,bash}]
indent_size = 4

# Java：AOSP 风格，4 空格缩进，100 列；import 不做 wildcard 折叠，
# 未使用的 import 由 Spotless 的 removeUnusedImports 删除。
[*.java]
indent_size = 4
max_line_length = 100
ij_java_class_count_to_use_import_on_demand = 9999
ij_java_names_count_to_use_import_on_demand = 9999
ij_java_packages_to_use_import_on_demand =
ij_java_layout_static_imports_separately = true
ij_java_imports_layout = *, |, javax.**, java.**, |, $*
