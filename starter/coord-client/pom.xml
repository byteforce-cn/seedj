<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.byteforce.seedj</groupId>
        <artifactId>starter-root</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>starter-coord-client</artifactId>
    <packaging>jar</packaging>

    <name>Byteforce :: Coord Client</name>
    <description>Byteforce Coord Client：客户端负载均衡（round-robin / random）与声明式 HTTP
        （RestClient / WebClient + @HttpExchange），承载 seedj ADR-0001 Phase 3 的消费侧能力</description>

    <dependencies>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>starter-coord</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>starter-coord-registry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- RestClient / HttpServiceProxyFactory / HttpRequestWrapper（声明式 HTTP 的核心面） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- WebClient 支持（可选：使用方引入 webflux 时条件启用） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 生成 spring-configuration-metadata.json，提供 IDE 属性提示 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
