<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.byteforce.seedj</groupId>
        <artifactId>starter-root</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>starter-eis-core</artifactId>
    <packaging>jar</packaging>

    <name>Byteforce :: EIS Core</name>
    <description>EIS 核心运行时：命令受理（幂等键 / 授权钩子 / 规则链 / 事件 / 审计 / 封口 同一事务）、
        双时间轴对象存储、outbox 与扩展 SPIs（eis/docs/LANDING-IAM.md §5.2①）</description>

    <dependencies>
        <!-- 统一上下文（RequestContext：traceId 等） -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <!-- Jackson 3（tools.jackson）序列化面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- JdbcTemplate / DataSourceUtils（PG16 为唯一数据权威，不引入其他存储） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 命令端点（可选：非 Web 场景仅用运行时） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 默认操作人解析（可选：读取 SecurityContext 的已认证主体） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 生成 spring-configuration-metadata.json，提供 IDE 属性提示 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
