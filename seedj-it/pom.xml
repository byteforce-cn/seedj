<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.byteforce.seedj</groupId>
        <artifactId>root</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>seedj-it</artifactId>
    <packaging>jar</packaging>

    <name>Byteforce Seedj :: Integration Tests</name>
    <description>三服务集成测试：IAM、HR、IM；src/main 不含代码</description>

    <properties>
        <!-- 集成测试模块不参与 API 兼容性门禁 -->
        <seedj.compat.skip>true</seedj.compat.skip>
        <!-- 纯测试模块，无主源码 -->
        <seedj.jacoco.guard.skip>true</seedj.jacoco.guard.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-workflow-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-transit-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-ai-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-im-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-iam-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 被测服务：只在此模块同时出现 -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-server-iam</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-server-hr</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-server-im</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试代码直接引用的库与实现 -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-iam-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-biz-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 架构门禁按模块读 target/classes（ModuleClassPath.MODULES）：这里的每一项都必须是
             seedj-it 的（直接或传递）依赖，否则 reactor 不构建它，干净克隆上必失败、本地则可能
             读到陈旧字节码。 -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-ai-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-server-ai</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-workflow-local</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-infra-local</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- coord provider 与其真集群夹具（test-jar）：coord 能力的端到端验证，见 CoordIT。 -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-infra-coord</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-infra-coord</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- 契约测试 TCK（core test-jar）：coord provider 直接 extends，不再抄一份断言。 -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>core</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-workflow-contract</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-transit-contract</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-ai-contract</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-im-contract</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-iam-contract</artifactId>
            <version>${revision}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-jdbc-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            AI pilot 夹具的 {@code @SeedjObject} record 在生产同一条路上生成 schema：只作编译期处理器，
            运行时不进 classpath。provided 只为让 reactor 把 seedj-codegen 纳入 -am 构建图。
        -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>seedj-codegen</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.byteforce.seedj</groupId>
                <artifactId>bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- JDK 23+ 默认关闭隐式注解处理；显式声明生成器与处理轮次（test-compile 也用这一组）。 -->
                    <proc>full</proc>
                    <annotationProcessorPaths combine.children="append">
                        <path>
                            <groupId>cn.byteforce.seedj</groupId>
                            <artifactId>seedj-codegen</artifactId>
                            <version>${revision}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
