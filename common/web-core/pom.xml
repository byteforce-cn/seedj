<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.byteforce.seedj</groupId>
        <artifactId>common-root</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>web-core</artifactId>
    <packaging>jar</packaging>

    <name>Byteforce :: Web Core</name>
    <description>Byteforce Web 核心模块：Web 应用相关功能</description>

    <dependencies>
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <!-- 仅编译期注解（@GenerateCodeEnum 为 SOURCE retention）：provided 不传递污染下游 -->
        <dependency>
            <groupId>cn.byteforce.seedj</groupId>
            <artifactId>codegen</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试：JSON 契约验证（Jackson 3，随 Boot 平台版本管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                仅本模块使用 @GenerateCodeEnum（本模块的 ResponseCode）；codegen 已从根 POM 的全局
                annotationProcessorPaths 下放到此处。combine.self="override" 覆盖父 POM 的处理器路径，
                避免根全局声明让无 codegen 依赖的模块（如 common/core）在干净仓库 / 并行构建中解析快照失败。
                codegen 为本模块 provided 依赖，reactor 顺序保证先于本模块构建。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths combine.self="override">
                        <path>
                            <groupId>cn.byteforce.seedj</groupId>
                            <artifactId>codegen</artifactId>
                            <version>${revision}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
